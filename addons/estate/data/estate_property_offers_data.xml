<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <data noupdate="1">

        <!-- 
        On créer par défaut 3 offres liées à l'annonce 'Big Villa' à l'installation du module.

        eval permet d'évaluer du code Python.
             Ici on s'en sert pour définir la valeur de create date de nos offres au jour d'installation du module.
             (ça sert pas à grand chose puisque le champ est déjà défini comme fields.Datetime.now() mais c'est pour montrer que ça marche).
        -->
        <record id="offer_1" model="estate.property.offers">
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="property_id" ref="estate.property_1"/>
            <field name="price">10000</field>
            <field name="validity">14</field>
            <field name="create_date" eval="datetime.now()"/>
        </record>

        <record id="offer_2" model="estate.property.offers">
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="property_id" ref="estate.property_1"/>
            <field name="price">1500000</field>
            <field name="validity">14</field>
            <field name="create_date" eval="datetime.now()"/>
        </record>

        <record id="offer_3" model="estate.property.offers">
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="property_id" ref="estate.property_1"/>
            <field name="price">1500001</field>
            <field name="validity">14</field>
            <field name="create_date" eval="datetime.now()"/>
        </record>

        <!--
        Il est possible d'appeler des fonctions de nos modèles sur les enregistrements que l'on crée.
        Ici on accepte l'offre 'offer_3' et on refuse les 2 autres ('offer_1' et 'offer_2').

        Odoo appelle la méthode avec la même convention que les appels RPC (call_kw).
        Pour une méthode qui utilise self (ce qui est le cas de nos méthode action_accept_offer et action_refuse_offer),
        le premier <value> corresponds aux ID sur lesquels vont s'exécuter la méthode.
        Si la méthode attendait des arguments positionnels, il faudrait ajouter des balise <value> et assigner des valeurs,
        dans l'ordre des arguments de la méthode.
        -->
        <function model="estate.property.offers" name="action_accept_offer">
            <value eval="[ref('estate.offer_3')]"/>
        </function>

        <function model="estate.property.offers" name="action_refuse_offer">
            <value eval="[ref('estate.offer_1')]"/>
        </function>

        <function model="estate.property.offers" name="action_refuse_offer">
            <value eval="[ref('estate.offer_2')]"/>
        </function>

    </data>

</odoo>
