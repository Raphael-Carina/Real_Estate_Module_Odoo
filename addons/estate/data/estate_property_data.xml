<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- 
    Avec le noupdate="1" les données ne sont chargées qu'à l'installation du module.
    L'utilisateur peut ensuite modifier les instances et ses modifications seront toujours
    conservées lorsque le module sera mis à jour.
    Sans cela, les modifications de l'utilisateur seraient perdues à chaque maj du module. 
    -->
    <data noupdate="1">

        <!-- 
        Ici on vient créer 2 annonces (instances de estate.property) par défaut à l'installation du module.

        Attention: j'ai essayé plusieurs fois mais à priori on ne peut pas écrire un champ et le laisser vide.
        C'est à dire que pour la première instance (Big Villa) on ne peut pas laisser :

        <field name="expected_price"></field>

        Il faut tout simplement ne pas l'indiquer si on veut laisser un champ vide.
        -->

        <record id="property_1" model="estate.property">
            <field name="name">Big Villa</field>
            <field name="state">new</field>
            <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">1600000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">100000</field>
            <field name="garden_orientation">south</field>
            <field name="property_type_id" ref="estate.type_1"/>
        </record>

        <record id="property_2" model="estate.property">
            <field name="name">Trailer home</field>
            <field name="state">cancelled</field>
            <field name="description">Home in a trailer park</field>
            <field name="postcode">54321</field>
            <field name="date_availability">1970-01-01</field>
            <field name="expected_price">100000</field>
            <field name="selling_price">120000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">10</field>
            <field name="facades">4</field>
            <field name="garage">False</field>
            <field name="property_type_id" ref="estate.type_1"/>
        </record>

    </data>

</odoo>
