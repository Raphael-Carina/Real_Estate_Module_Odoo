<?xml version="1.0" encoding="UTF-8"?>

<!--
Dans la documentation Odoo on parle de :
- master data : ce sont les données de base, créées dans data/ (c'est le cas ici). Il s'agit de données que l'on créer à l'installation du module (et à la maj du module si noupdate="0").
- demo data : ce sont des données de démo, créées dans demo/ .

Pour accéder aux master data on fait :
- En Python : env.ref(self, xml_id, raise_if_not_found=True). Cette méthode retourne le recordset lié à l'xml_id renseingé.
- En XML :
    <odoo>
    <record id="id1" model="tutorial.example">
        <field name="related_id" ref="module.relatedid"/>
    </record>
    </odoo>

    -> cela va appeler la méthode ref et stocker l'ID trouver dans le champ related_id du record d'ID id1 de tutorial.example .

Dans un fichier csv, pour remplir des champs relationnel, il faut faire suivre le nom de la colonne par ":id" :
id,parent_id:id,name
"child1","module.parent","Name1"
"child2","module.parent","Name2"
"child3","module.parent","Name3"

-> pour l'instance "Name1", on rempli le champ parent_id avec le recorset d'ID externe module.parent.

-->

<odoo>

    <!-- 
    Avec le noupdate="1" les données ne sont chargées qu'à l'installation du module.
    L'utilisateur peut ensuite modifier les instances et ses modifications seront toujours
    conservées lorsque le module sera mis à jour.
    Sans cela, les modifications de l'utilisateur seraient perdues à chaque maj du module. 
    -->
    <data noupdate="1">

        <!-- 
        Ici on vient créer 2 annonces (instances de estate.property) par défaut à l'installation du module.

        Attention: j'ai essayé plusieurs fois mais à priori on ne peut pas écrire un champ et le laisser vide.
        C'est à dire que pour la première instance (Big Villa) on ne peut pas laisser :

        <field name="expected_price"></field>

        Il faut tout simplement ne pas l'indiquer si on veut laisser un champ vide.

        Avec la notation <field name="xxx">value</field>, Odoo va automatiquement faire les conversion de type en fonction
        des types de champs à remplir.
        C'est à dire que pour le expected_price par exemple, Odoo converti automatiquement notre valeur 1600000 (str) en float.
        C'est pour ça que la ligne <field name="expected_price"></field> fait planter car Odoo tente de convertir '' (vide) en float.

        ref permet d'assigner une valeur de type Many2one à un champ via l'ID externe de l'enregistrement ciblé.
        eval permet de fournir une expression en Python pour calculer la valeur d'un champ. (attention ça n'a rien à voir avec les champs computes).
             l'expression est traité à l'installation (et potentiellement à la maj si pas de noupdate) du module puis la valeur est stockée en BDD.
             Une utilisation courante du eval consiste à faire : <field name="xxx" eval="False"/> afin de ne définir aucune valeur à un champ (y compris sur un champ non booléen, c'est tout l'intérêt).
             En effet, <field name="xxx">False</field> sur un champ non-booléen ne fonctionnerait pas.
        -->

        <record id="property_1" model="estate.property">
            <field name="name">Big Villa</field>
            <field name="state">new</field>
            <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">1600000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">100000</field>
            <field name="garden_orientation">south</field>
            <field name="property_type_id" ref="estate.type_1"/>
        </record>

        <record id="property_2" model="estate.property">
            <field name="name">Trailer home</field>
            <field name="state">cancelled</field>
            <field name="description">Home in a trailer park</field>
            <field name="postcode">54321</field>
            <field name="date_availability">1970-01-01</field>
            <field name="expected_price">100000</field>
            <field name="selling_price">120000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">10</field>
            <field name="facades">4</field>
            <field name="garage">False</field>
            <field name="property_type_id" ref="estate.type_1"/>
        </record>

        <!--
        Pour la propriété 'Big Villa' créer précédemment, on a créer des offres dans estate_property_offers_data.xml
        qu'on à liées à la propriété 'Big Villa'.

        Une autre façon de faire est d'utiliser Command.create pour créer directement une (ou des) offre depuis l'annonce,
        comme dans l'exemple qui suit 'Bourg House'.
        -->
        <record id="property_3" model="estate.property">
            <field name="name">Bourg House</field>
            <field name="state">new</field>
            <field name="description">A cozy house in a nice bourg</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">130000</field>
            <field name="bedrooms">2</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage">False</field>
            <field name="garden">False</field>
            <field name="garden_area" eval="False"/> <!-- garden_area est de type Integer, donc je ne peux pas faire "<field name="garden_area">False</field>" car Odoo essaierai de convertir False en Integer. Il faut passer par eval dans ce cas pour définir une valeur vide (nulle). -->
            <field name="garden_orientation" eval="False"></field>
            <field name="property_type_id" ref="estate.type_1"/>

            <!-- On créer une offre directement via Command.create -->
            <field name="offers_ids" eval="[
                Command.create({
                    'price': 105000,
                    'partner_id': ref('base.res_partner_2'),
                    'validity': 14,
                    'create_date': datetime.now(),
                    })
                ]"/>
        </record>

    </data>

</odoo>
