<?xml version="1.0"?>

<odoo>
    <record id="estate_property_tags_action" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">estate.property.tags</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- List view pour le modèle des tags -->
    <record id="estate_property_tags_list_view" model="ir.ui.view">
        <field name="name">estate.property.tags.list.view</field>
        <field name="model">estate.property.tags</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    
</odoo>